# ============================================================
# SAJUP Backend - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# ============================================================

# Porta do servidor (padrão: 5000)
PORT=5000

# URI de conexão com o MongoDB
# Opção 1 - Local:
MONGODB_URI=mongodb://localhost:27017/sajup
# Opção 2 - MongoDB Atlas (nuvem):
# MONGODB_URI=mongodb+srv://<usuario>:<senha>@cluster0.xxxxx.mongodb.net/sajup?retryWrites=true&w=majority

# Segredo para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=sua_chave_secreta_muito_longa_e_segura_aqui_12345

# Tempo de expiração do token JWT
JWT_EXPIRES_IN=7d

# Ambiente (development | production)
NODE_ENV=development
